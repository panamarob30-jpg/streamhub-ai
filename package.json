{
  "name": "streamhub-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:electron": "concurrently \"npm run dev\" \"npm run dev:server\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:all": "npm run build && cp -r dist/* server/public/",
    "build:electron": "npm run build:all && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "cd server && npm start",
    "electron": "electron ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.streamhub.ai",
    "productName": "StreamHub AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
